# 后端环境变量示例，复制为 .env 后按需填写，.env 已被 .gitignore 忽略
#
# 命名规则为 RAG_ 前缀加分组名，双下划线分隔嵌套层级
# RAG_LLM__API_KEY 对应 settings.llm.api_key
# RAG_RETRIEVAL__TOP_K 对应 settings.retrieval.top_k
# RAG_DATABASE__URL 对应 settings.database.url

# 必填：DeepSeek API
RAG_LLM__API_KEY=sk-REPLACE_WITH_YOUR_KEY
RAG_LLM__MODEL=deepseek-chat
RAG_LLM__BASE_URL=https://api.deepseek.com/v1

# 数据库、缓存与存储
RAG_DATABASE__URL=mysql+aiomysql://rag:rag123456@127.0.0.1:3306/rag_system?charset=utf8mb4
RAG_REDIS__URL=redis://127.0.0.1:6379/0
RAG_STORAGE__TYPE=local                 # local 或 minio
RAG_MINIO__ENDPOINT=127.0.0.1:9000
RAG_MINIO__ACCESS_KEY=minioadmin
RAG_MINIO__SECRET_KEY=minioadmin
RAG_MINIO__BUCKET=rag-documents

# 本地模型与离线模式
RAG_EMBEDDING__OFFLINE=true
# 缓存目录使用相对路径，以 agent/backend 为基准
RAG_EMBEDDING__CACHE_DIR=../../.hf-cache

# 种子数据只读引用
RAG_RESOURCE_DIR=../../product/resource

# 检索链路参数，以下均为默认值
# 每路召回 50 条，RRF 融合参数 k 为 60，融合后取 20 条，精排取 5 条，上下文预算 6000 字
# RAG_RETRIEVAL__DENSE_TOP_K 默认 50
# RAG_RETRIEVAL__SPARSE_TOP_K 默认 50
# RAG_RETRIEVAL__TOP_K 默认 20
# RAG_RETRIEVAL__FUSION 默认 rrf
# RAG_RETRIEVAL__RRF_K 默认 60
# RAG_RERANK__TOP_K 默认 5
# RAG_GENERATION__CONTEXT_MAX_CHARS 默认 6000
