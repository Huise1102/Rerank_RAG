# =============================================================================
# 后端环境变量示例 —— 复制为 .env 后按需填写（.env 已被 .gitignore 忽略）
#
# 命名规则：RAG_ + 分组名 + __ + 字段名（双下划线分隔嵌套层级）
#   RAG_LLM__API_KEY        -> settings.llm.api_key
#   RAG_RETRIEVAL__TOP_K    -> settings.retrieval.top_k
#   RAG_DATABASE__URL       -> settings.database.url
# =============================================================================

# ============================ 本地 Qwen（Ollama，必填）======================
# 先在本机运行 ollama serve，并确保已 pull qwen3:8b： ollama pull qwen3:8b
RAG_LLM__PROVIDER=ollama
RAG_LLM__BASE_URL=http://127.0.0.1:11434
RAG_LLM__MODEL=qwen3:8b
# 关闭 thinking（qwen3 默认会思考，单轮决策会慢 8-10 倍）
RAG_LLM__THINK=false
# 上下文窗口：证据上限 6000 字，4096 不够用
RAG_LLM__NUM_CTX=8192
# 服务端口（本版 8004；demo 8001 / product 8002 / agent 8003，四版可同时运行）
RAG_API__PORT=8004

# ============================ 数据库 / 缓存 / 存储 ===========================
RAG_DATABASE__URL=mysql+aiomysql://rag:rag123456@127.0.0.1:3306/rag_system?charset=utf8mb4
RAG_REDIS__URL=redis://127.0.0.1:6379/0
RAG_STORAGE__TYPE=local                 # local | minio
RAG_MINIO__ENDPOINT=127.0.0.1:9000
RAG_MINIO__ACCESS_KEY=minioadmin
RAG_MINIO__SECRET_KEY=minioadmin
RAG_MINIO__BUCKET=rag-documents

# ============================ 本地模型与离线模式 =============================
RAG_EMBEDDING__OFFLINE=true
# 相对路径以 qwen_rag/backend 为基准（../../ 即仓库根）
RAG_EMBEDDING__CACHE_DIR=../../.hf-cache

# ============================ 种子数据只读引用 ==============================
RAG_RESOURCE_DIR=../../product/resource
# ============================ 检索链路参数（勿改） ==========================
# 每路召回 50 -> RRF(k=60) 融合取 20 -> 交叉编码器精排取 5 -> 上下文预算 6000 字
# RAG_RETRIEVAL__DENSE_TOP_K=50
# RAG_RETRIEVAL__SPARSE_TOP_K=50
# RAG_RETRIEVAL__TOP_K=20
# RAG_RETRIEVAL__FUSION=rrf
# RAG_RETRIEVAL__RRF_K=60
# RAG_RERANK__TOP_K=5
# RAG_GENERATION__CONTEXT_MAX_CHARS=6000
