# 应用
APP_NAME=校园 RAG 知识库系统
DEBUG=false
API_PREFIX=/api/v1
SECRET_KEY=请替换为随机长字符串
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=请填写数据库口令
MYSQL_DATABASE=rag_campus

# Redis，留空则使用进程内限流
REDIS_URL=redis://127.0.0.1:6379/4

# 初始管理员
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=

# 登录与反馈限流
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=600
LOGIN_LOCK_SECONDS=600
FEEDBACK_HOURLY_LIMIT=10

# 企业微信登录，唯一的外部身份接入方式
# WECOM_ENABLED 打开且四项配置齐全时，移动端登录页展示企业微信登录按钮
# WECOM_REDIRECT_URI 为企业微信后台配置的网页授权回调地址，指向移动端 /wecom/callback
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=http://127.0.0.1:5176/wecom/callback
WECOM_API_BASE=https://qyapi.weixin.qq.com

# 大模型，兼容 OpenAI 协议
# LLM_PROVIDER 为默认模型来源，ollama 使用本地模型，api 调用在线接口，管理端可在模型配置页切换
LLM_PROVIDER=api
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=请填写大模型密钥
LLM_MODEL=deepseek-chat
# 本地 Ollama 参数，服务需先执行 ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120

# 向量与精排模型
# HF_ENDPOINT 为模型下载地址，默认使用镜像；可直连时改为 https://huggingface.co
# 模型缓存固定放在项目内 .hf-cache/，可提前复制已有模型目录复用，避免重复下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_ENABLED=true
HF_ENDPOINT=https://hf-mirror.com

# 检索参数
VECTOR_TOP_K=50
BM25_TOP_K=50
RRF_K=60
RERANK_TOP_N=5
RERANK_INPUT_K=20
CONTEXT_MAX_CHARS=6000
CHUNK_SIZE=600
CHUNK_OVERLAP=100
HISTORY_MAX_TURNS=5
UPLOAD_MAX_MB=20

# 结构化分块，clause 为条款级切分，recursive 与 fixed 为回退策略
CHUNK_STRATEGY=clause
CHUNK_MIN_SIZE=30
CLAUSE_MAX_CHARS=1200
PARENT_TEXT_MAX_CHARS=800
TABLE_MAX_ROWS=30

# 文档治理与转办
# 默认部门编码对应初始化脚本写入的教务处，待分配部门编码固定为 PENDING
DEFAULT_DEPARTMENT_CODE=JWC
TRANSFER_FIRST_RESPONSE_HOURS=24
TRANSFER_RESOLVE_HOURS=72
EVALUATION_MAX_SAMPLES=400

# 运行目录，留空则使用项目内默认目录
DATA_DIR=
STORAGE_DIR=
INDEXES_DIR=
LOGS_DIR=
