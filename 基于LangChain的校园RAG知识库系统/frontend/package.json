{
  "name": "campus-rag-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:admin": "cross-env VITE_APP_MODE=admin vite --port 5174",
    "dev:user": "cross-env VITE_APP_MODE=user vite --port 5175",
    "dev:mobile": "cross-env VITE_APP_MODE=mobile vite --port 5176",
    "build:admin": "cross-env VITE_APP_MODE=admin vite build --outDir dist/admin",
    "build:user": "cross-env VITE_APP_MODE=user vite build --outDir dist/user",
    "build:mobile": "cross-env VITE_APP_MODE=mobile vite build --outDir dist/mobile",
    "build": "npm run build:admin && npm run build:user && npm run build:mobile"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "axios": "1.7.9",
    "dompurify": "^3.2.3",
    "element-plus": "2.8.8",
    "marked": "^15.0.4",
    "pinia": "2.2.6",
    "qrcode": "^1.5.4",
    "vue": "3.5.13",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "cross-env": "7.0.3",
    "vite": "6.0.3"
  }
}
